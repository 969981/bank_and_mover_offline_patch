# Generated build and release trees
/bank/build/
/mover/build/
/bank/release/*
!/bank/release/.gitkeep
/mover/release/*
!/mover/release/.gitkeep

# Generated compiler and assembler output outside build trees
*.o
*.obj
*.elf
*.map
*.disasm.txt
armips-symbols.txt

# Decrypted/extracted title images and private runtime data
/bank/*.code
/mover/*.code
/bank/romfs/
/mover/romfs/
/bank/rom/*
!/bank/rom/.gitkeep
/mover/rom/*
!/mover/rom/.gitkeep
/bank/bankdata.bin
/mover/bankdata.bin
*.3ds
*.cia
*.cxi
*.dmp

# Local analysis indexes and caches
.codegraph/
.cache/
__pycache__/
*.pyc

# Editor and operating-system files
.idea/
.vs/
.vscode/
*.suo
*.user
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
